# ============================================================
# MarketAgent 环境变量示例
# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会被提交）
# ============================================================

# ---------------- LLM（必填）----------------
# 阿里云百炼 / DashScope 的 API Key
QIANWEN_API_KEY=sk-your-api-key-here
# OpenAI 兼容模式的 base_url
QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------------- MySQL（本地默认，按需修改）----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=cn_market

# ---------------- Milvus（本地默认，按需修改）----------------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=cn_announcement
